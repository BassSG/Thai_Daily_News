<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/story_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp">
  <ImageView android:id="@+id/story_photo" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:scaleType="centerCrop" android:background="@drawable/widget_photo_frame" android:clipToOutline="true" android:contentDescription="ภาพจากสำนักข่าว"/>
  <TextView android:id="@+id/story_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F0F1F4" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/story_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#94A2B8" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="3dp"/>
</LinearLayout>
