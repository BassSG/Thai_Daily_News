<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_dark">
  <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/widget_logo" android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/logo" android:contentDescription="Thai Daily News"/>
    <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="THAI DAILY" android:textColor="#D6B775" android:textSize="9sp" android:textStyle="bold" android:maxLines="1"/>
    <ImageView android:id="@+id/widget_settings" android:layout_width="26dp" android:layout_height="24dp" android:padding="4dp" android:src="@drawable/ic_settings" android:contentDescription="ตั้งค่าวิดเจ็ต"/>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="26dp" android:layout_height="24dp" android:padding="4dp" android:src="@drawable/ic_refresh" android:contentDescription="อัปเดตข่าว"/>
  </LinearLayout>
  <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ข่าวล่าสุด" android:textColor="#A8B2C3" android:textSize="8sp" android:layout_marginTop="6dp" android:maxLines="1"/>
  <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="top"/>
  <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="เปิดแอปเพื่อเริ่มอ่านข่าว" android:textColor="#8291A9" android:textSize="7sp" android:maxLines="1" android:layout_marginTop="3dp"/>
</LinearLayout>
